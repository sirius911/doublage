# Copier ce fichier en .env et l'adapter (ne jamais committer .env).

# Port publié sur la VM (vérifier qu'il est libre : ss -ltn ; 8090 est déjà pris sur svp-recvoc-a3p)
DOUBLAGE_PORT=8091
# Dossier des projets sur la VM
DOUBLAGE_DONNEES=/srv/apps/doublage/data

# Serveur Whisper interne
DOUBLAGE_WHISPER_URL=http://10.1.147.251:30000/v1/audio/transcriptions
DOUBLAGE_WHISPER_LANGUAGE=fr
# DOUBLAGE_WHISPER_MODEL=

# Voix
DOUBLAGE_TTS_LANGUAGE=french
DOUBLAGE_TTS_VOICE=estelle
# Cœurs utilisés par la synthèse (seule limite effective sur la VM, en cgroups v1)
DOUBLAGE_TTS_THREADS=2
# Accélération maximale d'une voix trop longue pour son créneau (1.15 = 15 % ; 1.0 = jamais)
# DOUBLAGE_ACCELERATION_MAX=1.15
# Une fois le modèle téléchargé (premier lancement), plus aucun accès à Hugging Face :
# HF_HUB_OFFLINE=1

# Proxy de l'établissement, pour le téléchargement du modèle Pocket TTS au premier lancement
# (Podman transmet déjà ceux de la VM ; les écrire ici rend le réglage explicite).
# Le serveur Whisper, interne, est toujours appelé sans proxy.
HTTP_PROXY=http://proxy.chprod.fr:8080
HTTPS_PROXY=http://proxy.chprod.fr:8080
NO_PROXY=localhost,127.0.0.1,10.1.147.251
