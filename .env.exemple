# Copier ce fichier en .env et l'adapter (ne jamais committer .env).

# Port publié sur la VM (vérifier qu'il est libre : ss -ltn)
DOUBLAGE_PORT=8090
# Dossier des projets sur la VM
DOUBLAGE_DONNEES=/srv/apps/doublage/data

# Serveur Whisper interne
DOUBLAGE_WHISPER_URL=http://10.1.147.251:30000/v1/audio/transcriptions
DOUBLAGE_WHISPER_LANGUAGE=fr
# DOUBLAGE_WHISPER_MODEL=

# Voix
DOUBLAGE_TTS_LANGUAGE=french
DOUBLAGE_TTS_VOICE=estelle
